# Set independently for the migration job and API process.
OMNIRELAY_DATABASE_URL='postgresql://omnirelay@postgres.example.test/omnirelay?sslmode=verify-full&sslrootcert=/run/secrets/postgresql/ca.crt'

OMNIRELAY_PUBLIC_ORIGIN='https://relay.example.test'
# 预发布使用独立的企业自建应用。将 PUBLIC_ORIGIN 下的完整
# /auth/feishu/callback HTTPS 地址登记到该应用，入口日志和 APM 过滤回调查询串。
# 使用部署的秘密管理设施注入 App Secret。不要将值填入本模板或验收证据。
OMNIRELAY_FEISHU_APP_ID='cli_example'
OMNIRELAY_FEISHU_APP_SECRET=''
OMNIRELAY_FEISHU_TENANT_KEY=''
# Set to the verified Open ID in this Feishu app before the first start.
OMNIRELAY_BOOTSTRAP_OPEN_ID=''
OMNIRELAY_LISTEN_ADDR=':8080'
# Password login and password changes require HTTPS all the way to Go.
# Mount the certificate and private key and set both paths to enable HTTPS on the listener.
OMNIRELAY_TLS_CERT_FILE=''
OMNIRELAY_TLS_KEY_FILE=''
OMNIRELAY_DIRECTORY_INTERVAL='1h'
OMNIRELAY_DIRECTORY_PAGE_BUDGET='1000'

# 飞书 Bot 实施约定：App ID 和租户标识必填。未注入 App Secret 时仍可通过本地账号管理和检测 Bot。
# 非敏感、单调递增的正整数。轮换时将新 Secret 与新代次一并下发，
# 验收前确认所有提供流量的副本均已切换。
# 不得填写 App Secret、令牌或其摘要；组织/App ID 迁移须使用独立流程。
OMNIRELAY_FEISHU_CREDENTIALS_GENERATION='1'
# 当前持有者心跳达到该时长即过期。Go duration，默认 30s，必须大于 0。
# 持有者仅在 SDK 连接健康时续写心跳，判定使用数据库时间和当前连接代次。
OMNIRELAY_FEISHU_BOT_HEARTBEAT_TTL='30s'

# Kubernetes 通过 Downward API 注入 namespace 和 Pod UID。两项同时为空时，长连接工作进程关闭。
# 每个部署预先创建一个 omnirelay-feishu-bot Lease，并将下列两项注入所有副本。
OMNIRELAY_FEISHU_BOT_LEASE_NAMESPACE=''
OMNIRELAY_FEISHU_BOT_POD_UID=''
